[Unit]
Description=rm-socat batch supervisor %i (one process, many forwards)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=__RUN_HELPER__ %i
Restart=always
RestartSec=1
LimitNOFILE=1048576
LimitNPROC=infinity
TasksMax=infinity
StandardOutput=null
StandardError=null
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
